# Copy this file to .env and fill in the values for local development.
# Real secrets must never be committed to the repository.

# --- Administrator ---
# openId of the user who becomes the admin role (optional).
OWNER_OPEN_ID=
# Secret: password for the single administrator login. Never commit a real value.
ADMIN_PASSWORD=

# --- Forge API ---
BUILT_IN_FORGE_API_URL=https://forge.manus.ai
# Secret: set via `wrangler secret put BUILT_IN_FORGE_API_KEY` for the Worker.
BUILT_IN_FORGE_API_KEY=

# --- Session signing ---
# Secret: session JWT signing key. Never commit a real value.
JWT_SECRET=

# --- Local server ---
# Preferred port for the local Node server (default 3000).
PORT=3000

# --- Client build-time ---
# API base URL (e.g. the Cloudflare Worker's /api/trpc).
# Falls back to the same-origin /api/trpc when unset.
VITE_API_URL=
# Static base for a custom domain (default /policy-insight-hub/ for GitHub Pages).
VITE_BASE_PATH=/policy-insight-hub/
# Optional Umami analytics (only injected when set at build time).
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=